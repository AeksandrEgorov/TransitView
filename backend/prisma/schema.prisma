generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["transitview"]
}

enum UserRole {
  Kasutaja
  Andmebaasi_toimetaja
  Administraator

  @@schema("transitview")
}

enum ReviewStatus {
  Ootel
  Kinnitatud
  Tagasi_lukatud

  @@schema("transitview")
}

enum VehicleCondition {
  Töökorras
  Ei_tööta
  Maha_kantud
  Müüdud
  Teadmata

  @@schema("transitview")
}

model Users {
  user_id       Int      @id @default(autoincrement())
  username      String   @unique
  email         String   @unique
  password_hash String
  role          UserRole @default(Kasutaja)
  created_at    DateTime @default(now())

  vehicles         Vehicles[] @relation("VehicleCreator")
  reviewed_vehicles Vehicles[] @relation("VehicleReviewer")

  photos          Photos[] @relation("PhotoAuthor")
  reviewed_photos Photos[] @relation("PhotoReviewer")

  created_cities Cities[] @relation("CityCreator")
  reviewed_cities Cities[] @relation("CityReviewer")

  created_models Models[] @relation("ModelCreator")
  reviewed_models Models[] @relation("ModelReviewer")

  created_companies Companies[] @relation("CompanyCreator")
  reviewed_companies Companies[] @relation("CompanyReviewer")

  created_branches Company_branches[] @relation("BranchCreator")
  reviewed_branches Company_branches[] @relation("BranchReviewer")

  @@schema("transitview")
}

model Counties {
  county_id Int    @id @default(autoincrement())
  name      String @unique

  cities Cities[]

  @@schema("transitview")
}

model Cities {
  city_id   Int @id @default(autoincrement())
  county_id Int
  name      String

  status         ReviewStatus @default(Ootel)
  created_by     Int?
  reviewed_by    Int?
  reviewed_at    DateTime?
  review_comment String?

  county Counties @relation(fields: [county_id], references: [county_id], onDelete: Restrict)

  creator  Users? @relation("CityCreator", fields: [created_by], references: [user_id], onDelete: SetNull)
  reviewer Users? @relation("CityReviewer", fields: [reviewed_by], references: [user_id], onDelete: SetNull)

  companies Companies[]
  branches  Company_branches[]
  photos    Photos[]

  @@unique([county_id, name])
  @@schema("transitview")
}

model Categories {
  category_id Int    @id @default(autoincrement())
  name        String @unique

  models Models[]

  @@schema("transitview")
}

model Models {
  model_id     Int    @id @default(autoincrement())
  category_id  Int
  manufacturer String
  name         String

  status         ReviewStatus @default(Ootel)
  created_by     Int?
  reviewed_by    Int?
  reviewed_at    DateTime?
  review_comment String?

  category Categories @relation(fields: [category_id], references: [category_id], onDelete: Restrict)

  creator  Users? @relation("ModelCreator", fields: [created_by], references: [user_id], onDelete: SetNull)
  reviewer Users? @relation("ModelReviewer", fields: [reviewed_by], references: [user_id], onDelete: SetNull)

  vehicles Vehicles[]

  @@unique([category_id, manufacturer, name])
  @@schema("transitview")
}

model Companies {
  company_id Int    @id @default(autoincrement())
  name       String
  city_id    Int?

  status         ReviewStatus @default(Ootel)
  created_by     Int?
  reviewed_by    Int?
  reviewed_at    DateTime?
  review_comment String?

  city Cities? @relation(fields: [city_id], references: [city_id], onDelete: SetNull)

  creator  Users? @relation("CompanyCreator", fields: [created_by], references: [user_id], onDelete: SetNull)
  reviewer Users? @relation("CompanyReviewer", fields: [reviewed_by], references: [user_id], onDelete: SetNull)

  branches Company_branches[]

  @@unique([name])
  @@schema("transitview")
}

model Company_branches {
  branch_id   Int    @id @default(autoincrement())
  company_id  Int
  city_id     Int
  branch_name String

  status         ReviewStatus @default(Ootel)
  created_by     Int?
  reviewed_by    Int?
  reviewed_at    DateTime?
  review_comment String?

  company Companies @relation(fields: [company_id], references: [company_id], onDelete: Restrict)
  city    Cities    @relation(fields: [city_id], references: [city_id], onDelete: Restrict)

  creator  Users? @relation("BranchCreator", fields: [created_by], references: [user_id], onDelete: SetNull)
  reviewer Users? @relation("BranchReviewer", fields: [reviewed_by], references: [user_id], onDelete: SetNull)

  vehicles Vehicles[]

  @@unique([company_id, city_id, branch_name])
  @@schema("transitview")
}

model Vehicles {
  vehicle_id Int @id @default(autoincrement())

  model_id  Int
  branch_id Int?

  reg_number String  @unique
  vla_year   Int?
  vin_code   String?
  chassis    String?

  condition VehicleCondition @default(Teadmata)

  status         ReviewStatus @default(Ootel)
  review_comment String?

  created_by  Int
  reviewed_by Int?
  reviewed_at DateTime?
  created_at  DateTime @default(now())

  model  Models            @relation(fields: [model_id], references: [model_id], onDelete: Restrict)
  branch Company_branches? @relation(fields: [branch_id], references: [branch_id], onDelete: SetNull)

  creator  Users  @relation("VehicleCreator", fields: [created_by], references: [user_id], onDelete: Restrict)
  reviewer Users? @relation("VehicleReviewer", fields: [reviewed_by], references: [user_id], onDelete: SetNull)

  photos Photos[]

  @@schema("transitview")
}

model Photos {
  photo_id Int @id @default(autoincrement())

  vehicle_id Int
  author_id  Int
  city_id    Int?

  place    String?
  taken_at DateTime?

  file_path            String
  cloudinary_public_id String?

  status         ReviewStatus @default(Ootel)
  review_comment String?
  reviewed_by    Int?
  reviewed_at    DateTime?
  created_at     DateTime @default(now())

  vehicle Vehicles @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade)
  author  Users    @relation("PhotoAuthor", fields: [author_id], references: [user_id], onDelete: Restrict)

  reviewer Users?  @relation("PhotoReviewer", fields: [reviewed_by], references: [user_id], onDelete: SetNull)
  city     Cities? @relation(fields: [city_id], references: [city_id], onDelete: SetNull)

  @@schema("transitview")
}